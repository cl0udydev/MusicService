@startuml
title Track search, lyrics and artwork
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam nodesep 35
skinparam ranksep 45
hide empty members

class SearchService {
  - _musicSource: IMusicSource
  - _parser: Parser
  - _httpService: HttpService
  + ChangeSource(source): void
  + SearchTracks(query): Task<SearchResult>
  + SearchLyrics(url): Task<SearchResult>
  + SearchCover(url): Task<SearchResult>
}
class Parser {
  + ParseSource(document: HtmlDocument, source: IMusicSource): SearchResult
  + ParseLyrics(document: JsonDocument): SearchResult
}
class HttpService {
  - _httpClient: HttpClient {static}
  + LoadHtmlAsync(url, errorType): Task<HtmlDocument?>
  + GetLyricsResponseAsync(url, errorType): Task<JsonDocument?>
  + DownloadBitmapAsync(url, errorType): Task<Bitmap?>
}
interface IMusicSource <<interface>> {
  + GeneralNodeArgs: string
  + FormingLink(query): string
  + GetNameNode(node): HtmlNode?
  + GetAuthorNode(node): HtmlNode?
  + GetDurationNode(node): HtmlNode?
  + GetLink(node): string?
  + GetImageLink(node): string?
}
class SearchResult {
  + Type: SearchResultType
  + Message: string
  + Tracks: List<Track>?
  + Lyrics: string?
  + Cover: Bitmap?
  + SearchResult(type, data, message)
}
class Track <<record>> {
  + Link: string
  + Name: string
  + Author: string
  + Duration: TimeSpan
  + ImageLink: string
  + LyricsLink: string
  + ToString(): string
}

SearchService ..> Parser
SearchService ..> HttpService
SearchService --> IMusicSource
SearchService ..> SearchResult
Parser ..> IMusicSource
Parser ..> Track
Parser ..> SearchResult
SearchResult ..> Track
@enduml
