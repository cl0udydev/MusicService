@startuml
title Playlist management and domain objects
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam nodesep 35
skinparam ranksep 45
hide empty members

class PlaylistManager {
  - playlists: Dictionary<int, Playlist>
  - allocatedIdLimit: int
  - availableIds: Queue<int>
  + Playlists: IReadOnlyDictionary<int, Playlist>
  + CreateAsync(): Task<PlaylistManager>
  + CreatePlaylist(): Task<Playlist>
  + DeletePlaylist(id): Task
  + AddTrackToPlaylist(id, track): Task
  + DeleteTrackFromPlaylist(id, track): Task
  + ChangePlaylistName(id, name): Task
}
class Playlist {
  + Id: int
  + Name: string
  + Tracks: List<Track>
  + AddTrack(track): void
  + RemoveTrack(track): void
  + ChangeName(name): void
}
class AppDataService <<static>> {
  + Playlists: IPlaylistsDataModel
  + Indices: IIndicesDataModel
  + InitAppData(): void
}
class Track <<record>> {
  + Link: string
  + Name: string
  + Author: string
  + Duration: TimeSpan
  + ImageLink: string
  + LyricsLink: string
  + ToString(): string
}

PlaylistManager --> Playlist
PlaylistManager ..> AppDataService
Playlist *-- Track
@enduml
